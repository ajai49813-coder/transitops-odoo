<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         VEHICLE ACTIONS
    ══════════════════════════════════════════════════════════ -->
    <record id="action_transit_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first vehicle!</p>
            <p>Manage your entire fleet from here.</p>
        </field>
    </record>

    <record id="action_vehicle_available" model="ir.actions.act_window">
        <field name="name">Available Vehicles</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('status', '=', 'available')]</field>
    </record>

    <record id="action_vehicle_maintenance" model="ir.actions.act_window">
        <field name="name">Vehicles Under Maintenance</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'maintenance')]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         MAINTENANCE ACTIONS
    ══════════════════════════════════════════════════════════ -->
    <record id="action_transit_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Records</field>
        <field name="res_model">transit.maintenance</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first maintenance!</p>
        </field>
    </record>

    <record id="action_maintenance_scheduled" model="ir.actions.act_window">
        <field name="name">Scheduled / In Progress</field>
        <field name="res_model">transit.maintenance</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('status', 'in', ['scheduled', 'in_progress'])]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         FUEL ACTIONS
    ══════════════════════════════════════════════════════════ -->
    <record id="action_transit_fuel" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">transit.fuel</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first fuel entry!</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         DOCUMENT ACTIONS
    ══════════════════════════════════════════════════════════ -->
    <record id="action_transit_document" model="ir.actions.act_window">
        <field name="name">Vehicle Documents</field>
        <field name="res_model">transit.vehicle.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload your first document!</p>
        </field>
    </record>

    <record id="action_document_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Documents</field>
        <field name="res_model">transit.vehicle.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('days_to_expiry', '&lt;=', 30), ('expiry_date', '!=', False)]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         DASHBOARD ACTION
         view_id references view_fleet_dashboard defined in
         dashboard_views.xml which loads before this file.
    ══════════════════════════════════════════════════════════ -->
    <record id="action_fleet_dashboard" model="ir.actions.act_window">
        <field name="name">Fleet Dashboard</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fleet_dashboard"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         ANALYTICS ACTIONS
         view_id refs are safe here because dashboard_views.xml
         loads before actions.xml in the manifest.
    ══════════════════════════════════════════════════════════ -->
    <record id="action_vehicle_pie_chart" model="ir.actions.act_window">
        <field name="name">Fleet Status Chart</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_vehicle_graph_pie"/>
    </record>

    <record id="action_fuel_graph" model="ir.actions.act_window">
        <field name="name">Fuel Cost Analysis</field>
        <field name="res_model">transit.fuel</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_fuel_graph"/>
    </record>

    <record id="action_maintenance_graph" model="ir.actions.act_window">
        <field name="name">Maintenance Cost Analysis</field>
        <field name="res_model">transit.maintenance</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_maintenance_graph"/>
    </record>

</odoo>
