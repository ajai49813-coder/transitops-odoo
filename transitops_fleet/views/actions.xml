<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         VEHICLE ACTIONS
    ═══════════════════════════════════════════════════════════════ -->

    <record id="action_transit_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first vehicle!
            </p>
            <p>Manage your entire fleet from here.</p>
        </field>
    </record>

    <!-- Filtered shortcuts -->
    <record id="action_vehicle_available" model="ir.actions.act_window">
        <field name="name">Available Vehicles</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('status', '=', 'available')]</field>
    </record>

    <record id="action_vehicle_maintenance" model="ir.actions.act_window">
        <field name="name">Vehicles Under Maintenance</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'maintenance')]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         MAINTENANCE ACTIONS
    ═══════════════════════════════════════════════════════════════ -->

    <record id="action_transit_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Records</field>
        <field name="res_model">transit.maintenance</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first maintenance!
            </p>
        </field>
    </record>

    <record id="action_maintenance_scheduled" model="ir.actions.act_window">
        <field name="name">Scheduled Maintenance</field>
        <field name="res_model">transit.maintenance</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('status', 'in', ['scheduled', 'in_progress'])]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         FUEL ACTIONS
    ═══════════════════════════════════════════════════════════════ -->

    <record id="action_transit_fuel" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">transit.fuel</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Log your first fuel entry!
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         DASHBOARD ACTION
    ═══════════════════════════════════════════════════════════════ -->

    <record id="action_fleet_dashboard" model="ir.actions.act_window">
        <field name="name">Fleet Dashboard</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fleet_dashboard"/>
    </record>

</odoo>
