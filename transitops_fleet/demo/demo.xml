    <record id="demo_maint_01" model="transit.maintenance">
        <field name="vehicle_id" ref="demo_vehicle_bus_01"/>
        <field name="service_type">oil_change</field>
        <field name="service_date" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        <field name="next_service_date" eval="(DateTime.now() + timedelta(days=60)).strftime('%Y-%m-%d')"/>
        <field name="garage_name">City Auto Works</field>
        <field name="mechanic_name">Rajan Kumar</field>
        <field name="cost">2500.00</field>
        <field name="status">completed</field>
        <field name="description">Full oil change with filter replacement. Engine checked.</field>
    </record>

    <record id="demo_maint_02" model="transit.maintenance">
        <field name="vehicle_id" ref="demo_vehicle_van_01"/>
        <field name="service_type">brake_service</field>
        <field name="service_date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
        <field name="next_service_date" eval="(DateTime.now() + timedelta(days=180)).strftime('%Y-%m-%d')"/>
        <field name="garage_name">Metro Garage</field>
        <field name="mechanic_name">Suresh Babu</field>
        <field name="cost">8500.00</field>
        <field name="status">in_progress</field>
        <field name="description">Front and rear brake pad replacement. Brake fluid flush.</field>
    </record>

    <record id="demo_maint_03" model="transit.maintenance">
        <field name="vehicle_id" ref="demo_vehicle_bus_02"/>
