    </record>

    <record id="demo_maint_04" model="transit.maintenance">
        <field name="vehicle_id" ref="demo_vehicle_truck_01"/>
        <field name="service_type">engine_overhaul</field>
        <field name="service_date" eval="(DateTime.now() - timedelta(days=60)).strftime('%Y-%m-%d')"/>
