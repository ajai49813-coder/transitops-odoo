<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         DEMO VEHICLES
    ═══════════════════════════════════════════════════════════════ -->

    <record id="demo_vehicle_bus_01" model="transit.vehicle">
        <field name="name">City Bus 01</field>
        <field name="vehicle_number">TRN-001</field>
        <field name="registration_number">TN01AB1234</field>
        <field name="vehicle_type">bus</field>
        <field name="brand">Tata</field>
        <field name="model">Starbus Ultra</field>
        <field name="manufacturing_year">2020</field>
        <field name="capacity">52</field>
        <field name="fuel_type">diesel</field>
        <field name="odometer">45230.5</field>
        <field name="status">available</field>
        <field name="insurance_number">INS-2024-001</field>
        <field name="insurance_expiry" eval="(DateTime.now() + timedelta(days=45)).strftime('%Y-%m-%d')"/>
        <field name="pollution_cert_number">PUC-2024-001</field>
        <field name="pollution_cert_expiry" eval="(DateTime.now() + timedelta(days=120)).strftime('%Y-%m-%d')"/>
        <field name="notes">Primary city route bus. Well maintained.</field>
    </record>

