<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fuel_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mb-4">
                        <h2>Fuel Consumption Report</h2>
                        <p class="text-muted">Generated on <span t-esc="context_today().strftime('%B %d, %Y')"/></p>
                    </div>

                    <!-- Fuel Table -->
                    <table class="table table-bordered table-striped mt-4">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Fuel Entry</th>
                                <th>Vehicle</th>
                                <th>Fuel Date</th>
                                <th>Station</th>
                                <th class="text-right">Odometer (km)</th>
                                <th class="text-right">Quantity (Litres)</th>
                                <th class="text-right">Cost/Litre</th>
                                <th class="text-right">Total Cost</th>
                                <th class="text-right">Mileage (km/L)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="fuel">
                                <tr>
                                    <td><span t-field="fuel.reference"/></td>
                                    <td><span t-field="fuel.vehicle_id.name"/></td>
                                    <td><span t-field="fuel.fuel_date"/></td>
                                    <td><span t-field="fuel.fuel_station"/></td>
                                    <td class="text-right"><span t-field="fuel.odometer_reading" t-options="{'widget': 'float', 'precision': 0}"/></td>
                                    <td class="text-right"><span t-field="fuel.quantity" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td class="text-right">$<span t-field="fuel.cost_per_litre" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td class="text-right">$<span t-field="fuel.total_cost" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td class="text-right"><span t-field="fuel.mileage" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="font-weight-bold table-active">
                                <td colspan="5">Total</td>
                                <td class="text-right"><span t-esc="sum(docs.mapped('quantity'))" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td></td>
                                <td class="text-right">$<span t-esc="sum(docs.mapped('total_cost'))" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
