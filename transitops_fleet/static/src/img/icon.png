<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <!-- Background -->
  <rect width="100" height="100" rx="16" fill="#875a7b"/>
  <!-- Bus body -->
  <rect x="10" y="35" width="80" height="38" rx="6" fill="#fff" opacity="0.95"/>
  <!-- Windows -->
  <rect x="18" y="42" width="14" height="12" rx="3" fill="#875a7b"/>
  <rect x="38" y="42" width="14" height="12" rx="3" fill="#875a7b"/>
  <rect x="58" y="42" width="14" height="12" rx="3" fill="#875a7b"/>
  <!-- Wheels -->
  <circle cx="28" cy="76" r="9" fill="#333"/>
  <circle cx="28" cy="76" r="4" fill="#fff"/>
  <circle cx="72" cy="76" r="9" fill="#333"/>
  <circle cx="72" cy="76" r="4" fill="#fff"/>
  <!-- Headlight -->
  <rect x="82" y="48" width="8" height="6" rx="2" fill="#ffc107"/>
  <!-- Front bumper -->
  <rect x="10" y="65" width="80" height="5" rx="2" fill="#ddd"/>
</svg>
