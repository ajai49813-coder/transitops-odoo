<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_maintenance_form" model="ir.ui.view">
        <field name="name">transit.maintenance.form</field>
        <field name="model">transit.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object"
                            invisible="status != 'pending'" class="btn-primary"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="status != 'in_progress'" class="btn-success"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="maintenance_type"/>
                            <field name="scheduled_date"/>
                            <field name="completed_date"/>
                        </group>
                        <group>
                            <field name="cost"/>
                            <field name="odometer_at_service"/>
                            <field name="next_service_km"/>
                            <field name="next_service_date"/>
                            <field name="technician"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transit_maintenance_list" model="ir.ui.view">
        <field name="name">transit.maintenance.list</field>
        <field name="model">transit.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="maintenance_type"/>
                <field name="scheduled_date"/>
                <field name="completed_date"/>
                <field name="cost"/>
                <field name="technician"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-info="status == 'in_progress'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_transit_maintenance_search" model="ir.ui.view">
        <field name="name">transit.maintenance.search</field>
        <field name="model">transit.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="technician"/>
                <filter string="Pending" name="pending" domain="[('status','=','pending')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status','=','in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('status','=','completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'maintenance_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transit_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">transit.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transit_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first maintenance!</p>
        </field>
    </record>
</odoo>
