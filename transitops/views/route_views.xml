<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Route Tree View -->
    <record id="view_transport_route_tree" model="ir.ui.view">
        <field name="name">transport.route.tree</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <tree string="Routes">
                <field name="route_id"/>
                <field name="name"/>
                <field name="source"/>
                <field name="destination"/>
                <field name="total_distance" sum="Total Distance"/>
                <field name="estimated_travel_time" widget="float_time"/>
                <field name="total_stops"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Route Form View -->
    <record id="view_transport_route_form" model="ir.ui.view">
        <field name="name">transport.route.form</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                        <button name="action_view_completed_trips" type="object" class="oe_stat_button" icon="fa-check" decoration-success="1">
                            <field name="completed_trip_count" widget="statinfo" string="Completed"/>
                        </button>
                        <button name="action_view_cancelled_trips" type="object" class="oe_stat_button" icon="fa-ban" decoration-danger="1">
                            <field name="cancelled_trip_count" widget="statinfo" string="Cancelled"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="route_id" class="oe_edit_only"/>
                        <h1>
                            <field name="route_id" placeholder="e.g. ROUTE-001"/>
                        </h1>
                        <label for="name" class="oe_edit_only"/>
                        <h2>
                            <field name="name" placeholder="e.g. Central - North Express"/>
                        </h2>
                    </div>
                    <group>
                        <group name="route_details" string="Route Locations">
                            <field name="source" placeholder="e.g. Central Station"/>
                            <field name="destination" placeholder="e.g. North Terminal"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="route_metrics" string="Metrics">
                            <field name="total_distance"/>
                            <field name="estimated_travel_time" widget="float_time"/>
                        </group>
                    </group>

                    <!-- Route Visualization Section -->
                    <group name="route_visualization" string="Active Trip Visualization">
                        <group>
                            <field name="total_stops"/>
                            <field name="remaining_stops"/>
                        </group>
                        <group>
                            <field name="distance_covered"/>
                            <field name="remaining_distance"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="stops_page" string="Stops &amp; Sequence">
                            <field name="stop_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="e.g. Stop A"/>
                                    <field name="distance_from_start"/>
                                </tree>
                            </field>
                        </page>
                        <page name="stops_desc" string="Additional Details">
                            <group>
                                <field name="stops" placeholder="Describe the stops and other details here..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Route Action -->
    <record id="action_transport_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">transport.route</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Route
            </p>
            <p>
                Define your transport routes, configure stops sequence, and monitor live status.
            </p>
        </field>
    </record>
</odoo>
