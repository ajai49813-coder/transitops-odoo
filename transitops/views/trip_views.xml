<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transit_trip_form" model="ir.ui.view">
        <field name="name">transit.trip.form</field>
        <field name="model">transit.trip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,scheduled,ongoing,completed,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="origin"/>
                            <field name="destination"/>
                        </group>

                        <group>
                            <field name="scheduled_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="distance_km"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="odometer_start"/>
                            <field name="odometer_end"/>
                            <field name="actual_distance"/>
                        </group>

                        <group>
                            <field name="passengers"/>
                            <field name="cargo_weight"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Fuel Records">
                            <field name="fuel_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="quantity_liters"/>
                                    <field name="cost_per_liter"/>
                                    <field name="total_cost"/>
                                    <field name="fuel_station"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>
      <record id="view_transit_trip_tree" model="ir.ui.view">
        <field name="name">transit.trip.tree</field>
        <field name="model">transit.trip</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="scheduled_date"/>
                <field name="actual_distance"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-info="status == 'ongoing'"
                       decoration-warning="status == 'scheduled'"
                       decoration-muted="status == 'draft'"
                       decoration-danger="status == 'cancelled'"/>
            </tree>
        </field>
    </record>
      <record id="view_transit_trip_search" model="ir.ui.view">
        <field name="name">transit.trip.search</field>
        <field name="model">transit.trip</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>

                <filter string="Draft"
                        name="draft"
                        domain="[('status','=','draft')]"/>

                <filter string="Scheduled"
                        name="scheduled"
                        domain="[('status','=','scheduled')]"/>

                <filter string="Ongoing"
                        name="ongoing"
                        domain="[('status','=','ongoing')]"/>

                <filter string="Completed"
                        name="completed"
                        domain="[('status','=','completed')]"/>

                <filter string="Cancelled"
                        name="cancelled"
                        domain="[('status','=','cancelled')]"/>

                <separator/>

                <filter string="This Month"
                        name="this_month"
                        domain="[('scheduled_date','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Vehicle"
                            name="group_vehicle"
                            context="{'group_by':'vehicle_id'}"/>

                    <filter string="Driver"
                            name="group_driver"
                            context="{'group_by':'driver_id'}"/>

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by':'status'}"/>

                    <filter string="Month"
                            name="group_month"
                            context="{'group_by':'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
      <record id="action_transit_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">transit.trip</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_transit_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first trip!
            </p>
        </field>
    </record>

</odoo>