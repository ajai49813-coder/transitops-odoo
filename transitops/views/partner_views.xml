<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_transitops_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.transitops.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add Trips smart button to the partner button box -->
            <div name="button_box" position="inside">
                <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-road">
                    <field name="total_trips" widget="statinfo" string="Trips"/>
                </button>
            </div>
            
            <!-- Add Driver Performance Stats Notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="TransitOps Performance" name="transitops_performance">
                    <group name="driver_stats" string="Driver Performance Statistics">
                        <group>
                            <field name="total_trips" readonly="1"/>
                            <field name="completed_trips" readonly="1"/>
                            <field name="cancelled_trips" readonly="1"/>
                        </group>
                        <group>
                            <field name="average_trip_time" widget="float_time" readonly="1"/>
                            <field name="average_distance" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
