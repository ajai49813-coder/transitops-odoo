<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_notification_form" model="ir.ui.view">
        <field name="name">transit.notification.form</field>
        <field name="model">transit.notification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" string="Mark Resolved" type="object"
                            invisible="status != 'active'" class="btn-success"/>
                    <button name="action_dismiss" string="Dismiss" type="object"
                            invisible="status != 'active'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,resolved,dismissed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="alert_type"/>
                            <field name="severity" widget="badge"
                                   decoration-info="severity == 'info'"
                                   decoration-warning="severity == 'warning'"
                                   decoration-danger="severity == 'critical'"/>
                            <field name="alert_date"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="resolved_date"/>
                            <field name="resolved_by"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transit_notification_tree" model="ir.ui.view">
        <field name="name">transit.notification.tree</field>
        <field name="model">transit.notification</field>
        <field name="arch" type="xml">
            <tree decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'">
                <field name="title"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"
                       decoration-info="severity == 'info'"
                       decoration-warning="severity == 'warning'"
                       decoration-danger="severity == 'critical'"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="alert_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'resolved'"
                       decoration-warning="status == 'active'"
                       decoration-muted="status == 'dismissed'"/>
            </tree>
        </field>
    </record>

    <record id="view_transit_notification_search" model="ir.ui.view">
        <field name="name">transit.notification.search</field>
        <field name="model">transit.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="Critical" name="critical" domain="[('severity','=','critical')]"/>
                <filter string="Warning" name="warning" domain="[('severity','=','warning')]"/>
                <filter string="Resolved" name="resolved" domain="[('status','=','resolved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'alert_type'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transit_notification" model="ir.actions.act_window">
        <field name="name">Alerts &amp; Notifications</field>
        <field name="res_model">transit.notification</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_transit_notification_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No active alerts. All clear!</p>
        </field>
    </record>
</odoo>
