<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_driver_form" model="ir.ui.view">
        <field name="name">transit.driver.form</field>
        <field name="model">transit.driver</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,on_leave,inactive,suspended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Driver Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="date_hired"/>
                        </group>
                        <group>
                            <field name="license_number"/>
                            <field name="license_class"/>
                            <field name="license_expiry"/>
                            <field name="license_days_left"/>
                            <field name="vehicle_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Trips">
                            <field name="trip_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="origin"/>
                                    <field name="destination"/>
                                    <field name="scheduled_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transit_driver_list" model="ir.ui.view">
        <field name="name">transit.driver.list</field>
        <field name="model">transit.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="phone"/>
                <field name="license_number"/>
                <field name="license_class"/>
                <field name="license_expiry"/>
                <field name="license_days_left"/>
                <field name="vehicle_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'on_leave'"
                       decoration-danger="status == 'suspended'"
                       decoration-muted="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <record id="view_transit_driver_search" model="ir.ui.view">
        <field name="name">transit.driver.search</field>
        <field name="model">transit.driver</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_number"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="On Leave" name="on_leave" domain="[('status','=','on_leave')]"/>
                <filter string="Suspended" name="suspended" domain="[('status','=','suspended')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="License Class" name="group_license" context="{'group_by': 'license_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transit_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">transit.driver</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transit_driver_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first driver!</p>
        </field>
    </record>
</odoo>
