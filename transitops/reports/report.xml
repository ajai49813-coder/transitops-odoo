<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Summary PDF Report -->
    <record id="action_report_vehicle_pdf" model="ir.actions.report">
        <field name="name">Vehicle Summary Report</field>
        <field name="model">transit.vehicle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transitops.report_vehicle_summary</field>
        <field name="report_file">transitops.report_vehicle_summary</field>
        <field name="binding_model_id" ref="model_transit_vehicle"/>
        <field name="binding_type">report</field>
    </record>

