<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         LIST VIEW
    ================================================================ -->
    <record id="view_transit_vehicle_list" model="ir.ui.view">
        <field name="name">transit.vehicle.list</field>
        <field name="model">transit.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles"
                  decoration-danger="status == 'out_of_service'"
                  decoration-warning="status == 'maintenance'">
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="year"/>
                <field name="fuel_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-danger="status == 'out_of_service'"
                       decoration-warning="status == 'maintenance'"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         FORM VIEW
    ================================================================ -->
    <record id="view_transit_vehicle_form" model="ir.ui.view">
        <field name="name">transit.vehicle.form</field>
        <field name="model">transit.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,maintenance,out_of_service"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="license_plate"/>
                        </group>
                        <group string="Specifications">
                            <field name="year"/>
                            <field name="fuel_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <!-- Chatter for Activity & Logs -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         KANBAN VIEW
    ================================================================ -->
    <record id="view_transit_vehicle_kanban" model="ir.ui.view">
        <field name="name">transit.vehicle.kanban</field>
        <field name="model">transit.vehicle</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-2">
                            <strong><field name="license_plate"/></strong>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'active'"
                                   decoration-danger="status == 'out_of_service'"
                                   decoration-warning="status == 'maintenance'"/>
                        </div>
                        <div>
                            <span class="text-muted"><field name="brand"/> <field name="model_name"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         SEARCH VIEW
    ================================================================ -->
    <record id="view_transit_vehicle_search" model="ir.ui.view">
        <field name="name">transit.vehicle.search</field>
        <field name="model">transit.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="license_plate" string="License Plate"/>
                <field name="brand" string="Brand"/>
                <field name="model_name" string="Model"/>
                <filter name="active_vehicles" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="in_maintenance" string="In Maintenance" domain="[('status', '=', 'maintenance')]"/>
                <filter name="out_of_service" string="Out of Service" domain="[('status', '=', 'out_of_service')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_fuel" string="Fuel Type" context="{'group_by': 'fuel_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         ACTION
    ================================================================ -->
    <record id="action_transit_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">transit.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_transit_vehicle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first vehicle to the fleet!
            </p>
            <p>Track plates, status, maintenance, and fuel configuration.</p>
        </field>
    </record>

    <!-- ================================================================
         MENU STRUCTURE
    ================================================================ -->
    <!-- Root menu for TransitOps -->
    <menuitem id="menu_transitops_root"
              name="TransitOps"
              sequence="10"
              web_icon="transitops_driver,static/description/icon.png"/>

    <!-- Fleet/Vehicle submenu -->
    <menuitem id="menu_transitops_vehicles"
              name="Fleet"
              parent="menu_transitops_root"
              sequence="20"/>

    <!-- Vehicle List -->
    <menuitem id="menu_transitops_vehicle_list"
              name="Vehicle List"
              parent="menu_transitops_vehicles"
              action="action_transit_vehicle"
              sequence="10"/>

</odoo>
